# Локальний запуск бекенду без Docker (uvicorn напряму)
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://osint_user:osint_pass@localhost:5432/osint_hub
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change_me_jwt_secret_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ANTHROPIC_API_KEY=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
